{
  "name": "brand-kit",
  "version": "0.0.1",
  "author": "Constructive <hello@constructive.io>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/brand-kit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:dev": "pnpm -r run build:dev",
    "clean": "pnpm -r run clean",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "deps": "pnpm up -r -i -L",
    "policy": "pnpm-policy generate",
    "policy:check": "pnpm-policy check",
    "generate": "node packages/cli/dist/cli.js generate --out assets/generated",
    "dev": "pnpm --filter site dev"
  },
  "devDependencies": {
    "@constructive-io/eslint-config": "^0.2.0",
    "@constructive-io/pnpm-policy": "0.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "lerna": "^9.0.3",
    "makage": "^0.5.1",
    "pnpm-policy": "^0.5.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
